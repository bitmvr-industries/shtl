#!/usr/bin/env bash

source lib/shtl_functions.sh

if [ "$#" -eq 0 ]; then
   echo "No arguments were passed"
   shuttle::usage
fi

while (( "$#" ));  do
	case $1 in
		-l|--list)
			shuttle::listRoutes
			shift
			;;	
		-a|--add)
			shift
			shuttle::addRoute $1 $2
			break
			;;
		-d|--delete)
			shift
			shuttle::deleteRoute $1
			break
			;;
		*)
			shuttle::usage
			;;
	esac
done
