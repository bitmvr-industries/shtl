#!/usr/bin/env bash

source lib/shtl_functions.sh

if [[ "$#" -eq 0 ]]; then
   echo "No arguments were passed"
   shuttle::usage
fi

while (( "$#" ));  do
	case $1 in
		-l|--list)
			shuttle::listRoutes
			break
			;;	
		-a|--add)
			shift
			if shuttle::routeNameExists "$1"; then
				echo "It appears a route already exists with this name"
			else
				shuttle::addRoute "$1" "$2"
			fi
			break
			;;
		-d|--delete)
			shift
			shuttle::deleteRoute "$1"
			break
			;;
		-h|--help)
			shuttle::usage
			break
			;;
		*)
			if shuttle::routeNameExists "$1"; then
      	echo "Switching directory"
				shuttle::route "$1"
		else
				echo "Invalid argument"
				shuttle::usage
      fi
      break
			;;
	esac
done
