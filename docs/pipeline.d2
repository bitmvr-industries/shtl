# How shtl works: from `shtl ROUTE_NAME` to `cd`
vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

classes: {
  step: {style.border-radius: 6}
  decision: {shape: diamond}
  error: {style: {fill: "#fde2e2"; stroke: "#c0392b"}}
  data: {shape: cylinder}
}

user: You {shape: person}

shell: Your shell (bash / zsh) {
  fn: "shtl() shell function\nloaded by eval \"\$(shtl init)\"" {class: step}
  kind: First argument? {class: decision}
  cd: "cd -- \"\$dest\"" {class: step}
  fn -> kind
}

script: shtl script {
  needs: "Command needs\nthe routes file?" {class: decision}
  init: "shtl_init\n- create the routes file if missing\n- check the first line is the v1 header" {class: step}
  badfile: "Log ERROR: not a routes file,\nrun shtl doctor\nexit 1" {class: error}
  dispatch: Dispatch subcommand {class: decision}

  path: "path NAME [SUBDIR]" {class: step}
  exists: "Route exists?" {class: decision}
  dirok: "Route directory exists?\nSUBDIR relative and exists?" {class: decision}
  print: "Print path to stdout\n(~/ expanded)" {class: step}
  suggest: "Log ERROR\nsuggest similar routes\nexit 1" {class: error}
  fail: "Log ERROR\nexit 1" {class: error}

  write: "add / update / remove\npersist / clean" {class: step}
  edit: "Change only that route's line\n(order, comments and\nblank lines stay)" {class: step}
  swap: "Write a temp file next to\nthe routes file, then mv it over\n(a symlink stays a symlink)" {class: step}
  read: "list / ls (sorted by name)\nlist --names" {class: step}
  doctor: "doctor\nreport problems\nwith line numbers" {class: step}
  rc: "setup / unsetup\nadd or remove the\neval line" {class: step}
  info: "help / init / version" {class: step}

  needs -> init: "yes"
  needs -> dispatch: "no:\nhelp, doctor, setup,\nunsetup, init, version"
  init -> dispatch: header OK
  init -> badfile: bad header

  dispatch -> path: path
  dispatch -> write: change routes
  dispatch -> read: read routes
  dispatch -> doctor
  dispatch -> rc
  dispatch -> info
  path -> exists
  exists -> dirok: yes
  exists -> suggest: no
  dirok -> print: yes
  dirok -> fail: no
  write -> edit
  edit -> swap
}

routes: "routes file\n~/.config/shtl/routes\n# shtl routes v1\none NAME[FLAGS]:PATH per line\n(paths in home stored as ~/)" {class: data}
rcfile: "shell rc file\n~/.zshrc, ~/.bashrc\nor bash login file" {class: data}

user -> shell.fn: "shtl ROUTE_NAME [SUBDIR]"
shell.kind -> script.needs: "command or flag:\ncommand shtl ARGS"
shell.kind -> script.needs: "route name:\ncommand shtl path NAME [SUBDIR]"
shell.cd <- script.print: dest {style.stroke-dash: 3}
user <- script.suggest: error message {style.stroke-dash: 3}
user <- script.fail: error message {style.stroke-dash: 3}
user <- script.badfile: error message {style.stroke-dash: 3}

script.init -> routes: create / check
script.exists -> routes: look up NAME
script.swap -> routes: write
script.read -> routes
script.doctor -> routes: check
script.rc -> rcfile: edit
